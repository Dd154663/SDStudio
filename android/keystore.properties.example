# SDStudio Android 릴리스 서명 설정 예시 (sign-apk.cjs 가 읽음)
#
# 이 파일을 같은 폴더에 keystore.properties 로 복사한 뒤 값을 채우세요.
# keystore.properties 는 .gitignore 대상이며 절대 커밋하지 않습니다(공개 저장소).
# 키 파일(.jks/.keystore)과 lineage 파일도 저장소 밖에 두세요.
#
# 형식: 한 줄에 key=value. # 로 시작하는 줄은 주석. 값의 앞뒤 공백은 제거됩니다.
# 경로의 \ 는 그대로 적으면 됩니다(이스케이프 불필요). 상대 경로는 이 파일 위치(android/) 기준.
# 비밀번호는 sign-apk.cjs 가 환경 변수로만 apksigner/keytool 에 넘기며 화면에 출력하지 않습니다.
#
# 키 회전 구성: v1/v2/v3.0 = 원래 키(5.4.0 까지 배포한 디버그 키 사본), v3.1 = 새 정식 키 + lineage.
# 두 키와 lineage 는 앞으로 매 릴리스에 필요하므로 영구 보관·백업하세요.

# ── 새 정식 키 ──
# 키 저장소 경로(PKCS12 또는 JKS)
releaseStoreFile=C:\path\to\sdstudio-release.jks
# 키 저장소 비밀번호
releaseStorePassword=CHANGE_ME
# 키 별칭. 생략하면 저장소의 개인 키 항목이 정확히 1개일 때 자동 감지합니다.
#releaseKeyAlias=key0
# 키 비밀번호. 생략하면 releaseStorePassword 와 같다고 봅니다(PKCS12 는 보통 동일).
#releaseKeyPassword=CHANGE_ME

# ── 원래 키(디버그 키 사본) ──
# 5.4.0 까지 배포 APK 를 서명한 키. 인증서 SHA-256 이 45:CE:D5:49:… 가 아니면 스크립트가 서명을 거부합니다.
originalStoreFile=C:\path\to\sdstudio-original.keystore
# 키 저장소 비밀번호
originalStorePassword=CHANGE_ME
# 키 별칭(생략 시 androiddebugkey)
#originalKeyAlias=androiddebugkey
# 키 비밀번호(생략 시 originalStorePassword 와 동일)
#originalKeyPassword=CHANGE_ME

# ── lineage(원래 키 → 새 키 이관 증명) ──
# 생략하면 releaseStoreFile 과 같은 폴더의 sdstudio.lineage 를 사용합니다.
# 파일이 없으면 sign 실행 시 1회 생성합니다. 생성 후 키와 함께 백업하세요.
#lineageFile=C:\path\to\sdstudio.lineage
